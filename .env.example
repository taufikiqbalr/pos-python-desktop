# Store / terminal identity
POS_STORE_NAME=Toko Koperasi BRIN
POS_STORE_ADDRESS=Badan Riset dan Inovasi Nasional
POS_STORE_PHONE=-
POS_STORE_ID=BRIN-STORE-001
POS_REGISTER_ID=REG-01
POS_DEVICE_ID=POS-KASIR-01
POS_TAX_PERCENT=0

# Optional paths. Leave blank to use defaults.
# Windows packaged default: %LOCALAPPDATA%\\KoperasiBRIN-POS\\data\\pos.db
# POS_DATA_DIR=C:\\KoperasiBRIN-POS\\data
# POS_DB_PATH=C:\\KoperasiBRIN-POS\\data\\pos.db
# POS_RECEIPT_DIR=C:\\KoperasiBRIN-POS\\receipts

# ESC/POS printer: disabled | network | usb
POS_PRINTER_MODE=disabled
POS_PRINTER_HOST=192.168.1.100
POS_PRINTER_PORT=9100
# USB IDs accept decimal or 0x-prefixed hexadecimal.
POS_PRINTER_USB_VENDOR_ID=0x0000
POS_PRINTER_USB_PRODUCT_ID=0x0000
POS_PRINTER_PROFILE=default

# Cash drawer connected through ESC/POS printer
POS_CASH_DRAWER_ENABLED=false
POS_CASH_DRAWER_PIN=2
POS_AUTO_PRINT_RECEIPT=false
POS_AUTO_OPEN_DRAWER_CASH=false

# Central event synchronization
POS_SYNC_ENABLED=false
POS_SYNC_API_URL=https://example.internal
POS_SYNC_API_TOKEN=
POS_SYNC_TIMEOUT_SECONDS=5

# Optional upstream master-data/business APIs
POS_INVENTORY_API_URL=
POS_MEMBERSHIP_API_URL=
POS_PRICING_API_URL=
POS_BUSINESS_API_TOKEN=
POS_BUSINESS_API_TIMEOUT_SECONDS=4
POS_INTEGRATION_FALLBACK_LOCAL=true
